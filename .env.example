# ============================================================
# طقس بلاد الشام - نموذج متغيّرات البيئة
# Levant Weather - environment variables example
# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env إلى Git.
# Copy this file to .env and edit. Never commit .env.
# ============================================================

# ---------- مجلد البيانات (مطلوب في الإنتاج) ----------
# كل ما يُكتب (قواعد البيانات، مفاتيح VAPID) يذهب هنا.
# على نظام ملفات للقراءة فقط، اضبطه على مجلد قابل للكتابة.
DATA_DIR=./data

# ---------- الموقع ----------
# رابط الموقع الكامل (يُستخدم في sitemap وcanonical وog:url)
SITE_URL=https://example.com
CONTACT_EMAIL=ads@example.com

# ---------- Open-Meteo ----------
# اتركه فارغاً للاستخدام المجاني (غير تجاري فقط!).
# للإطلاق التجاري ضع مفتاح الخطة التجارية.
OPEN_METEO_API_KEY=

# ---------- الإشعارات (Web Push) ----------
# بريد المسؤول في مطالبات VAPID. مفاتيح VAPID تُولَّد تلقائياً في DATA_DIR.
VAPID_SUBJECT=mailto:admin@example.com

# ---------- لوحة الإعلانات ----------
# رمز الدخول للوحة /admin. إن تركته فارغاً يُولَّد رمز ويُطبع في سجل الخادم
# عند أول تشغيل. في الإنتاج اضبطه دائماً.
ADMIN_TOKEN=
ADMIN_SESSION_HOURS=12

# ---------- الإعلانات ----------
# هل تُحمَّل الإعلانات قبل موافقة الزائر على ملفات تعريف الارتباط؟
# 0 = لا (الافتراضي، يحترم الخصوصية) · 1 = نعم
ADS_BEFORE_CONSENT=0
# معرّف شبكة AdSense (اختياري). يمكن ضبطه من اللوحة أيضاً.
ADSENSE_CLIENT=
# أسطر ads.txt إضافية، مفصولة بـ ;
ADS_TXT_ENTRIES=

# ---------- حدود الطلب وتحديد المعدل ----------
MAX_BODY_BYTES=65536
RL_WEATHER=60
RL_OVERVIEW=20
RL_GRID=30
RL_PUSH=20
RL_ADS=120
RL_LEAD=5
RL_ADMIN=30

# ---------- الكاش والفترات ----------
CACHE_TTL=1800
GRID_TTL=3600
PUSH_EVERY=1800
ACCURACY_EVERY=21600
